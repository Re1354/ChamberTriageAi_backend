# ---------------------------------------------------------------
# ChamberTriage API — এটা কপি করে `.env` নামে রাখুন (git-এ যাবে না)
# ---------------------------------------------------------------
NODE_ENV=development
PORT=4100

# Supabase → Project Settings → Database → Connect → "Session pooler" (IPv4)
# উদাহরণ: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
DB_POOL_MAX=5
DB_SSL=true

# Supabase → Settings → API Keys → Secret key (sb_secret_...) বা legacy service_role key
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# শুধু পুরনো (HS256 JWT) প্রজেক্টে দরকার; নতুন প্রজেক্টে খালি রাখুন — JWKS দিয়ে যাচাই হয়
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=visit-media

# Gemini (Google AI Studio). MOCK_LLM=true দিলে key ছাড়াই নকল-AI দিয়ে পুরো অ্যাপ চলে (ডেভ/লোড টেস্ট)।
# MOCK_LLM=false আর key খালি → AI বন্ধ, প্রশ্ন-ব্যাংক + নিয়ম-ভিত্তিক সামারি (সার্ভার ক্র্যাশ করে না)
GEMINI_API_KEY=
MOCK_LLM=true
MODEL_TURN=gemini-3.1-flash-lite
MODEL_FINAL=gemini-3.5-flash-lite
EMBEDDING_MODEL=
# AI Studio-তে আপনার প্রজেক্টের আসল দৈনিক সীমা দেখে বসান (পেইড টিয়ারে বড় সংখ্যা দিন)
DAILY_RPD_TURN=500
DAILY_RPD_FINAL=500
QUOTA_SAFETY=0.85

# CORS / URLs
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# নিরাপত্তা (লম্বা র‍্যান্ডম স্ট্রিং দিন)
CRON_SECRET=change-me-to-a-long-random-string
IP_HASH_SALT=change-me-too

# নীতিমালা
IMAGE_RETENTION_DAYS=14
MAX_NEW_VISITS_PER_IP_PER_HOUR=5
CROSS_DOCTOR_SEARCH_PER_HOUR=60
CROSS_DOCTOR_VIEW_WINDOW_HOURS=12

# সার্ভারেই সামারি-ওয়ার্কার চালানো হবে কিনা (বড় স্কেলে আলাদা worker সার্ভিসে false)
RUN_WORKER=true
# postgres (প্রোডাকশন) | memory (শুধু লোকাল টেস্ট)
CHECKPOINTER=postgres

# ডিবাগ: 1 দিলে প্রতিটি DB কুয়েরির সময় লগ হয়
DEBUG_DB=0
