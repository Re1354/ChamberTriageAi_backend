{
  "name": "chambertriage-ai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "ChamberTriage AI — API (Fastify + LangGraph.js + Supabase)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "create-admin": "tsx scripts/createAdmin.ts",
    "embed-kb": "tsx scripts/embedKb.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "dev-accounts": "tsx scripts/devAccounts.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.4.3",
    "@google/genai": "3.6.1",
    "@langchain/core": "1.4.2",
    "@langchain/langgraph": "1.7.5",
    "@langchain/langgraph-checkpoint-postgres": "1.1.4",
    "@supabase/supabase-js": "2.119.1",
    "fastify": "5.12.8",
    "jose": "6.2.18",
    "pg": "8.23.1",
    "tsup": "9.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
