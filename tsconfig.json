{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@chamberai/shared": [
        "./shared/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "scripts",
    "shared/src",
    "tsup.config.ts"
  ]
}
